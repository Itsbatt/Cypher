<?xml version="1.0" encoding="utf-8"?>
<!--
    Cypher only talks to HTTPS endpoints (YouTube, yt-dlp releases, lyrics,
    playlist sharing). Cleartext stays disabled everywhere so a downgraded
    connection fails instead of leaking playback URLs or share codes.
-->
<network-security-config>
    <!-- Cypher Connect allows HTTP communication with Cypher Desktop on the local LAN (port 8484) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
